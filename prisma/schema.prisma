generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  role     String @default("USER")
  plan     String @default("FREE")

  sessions       Session[]
  supportTickets SupportTicket[]
  tradingBots    TradingBot[]
  tradingSignals TradingSignal[]
  trades         Trade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]
}

model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  senderId   String?
  senderType String
  message    String
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model TradingBot {
  id          String  @id @default(cuid())
  userId      String
  name        String
  type        String
  category    String  @default("ANALYSIS")
  description String?

  symbol     String?
  timeframe  String?
  marketType String?

  isActive Boolean @default(false)

  // =========================
  // Trade Size / Risk
  // =========================

  lotMode     String @default("FIXED")
  lotSize     Float  @default(0.01)
  riskPercent Float  @default(1)

  // =========================
  // TP / SL
  // =========================

  takeProfit Float?
  stopLoss   Float?
  riskReward Float?

  trailingStop        Boolean @default(false)
  trailingStopDistance Float?

  breakEven        Boolean @default(false)
  breakEvenTrigger Float?

  // =========================
  // Daily Risk Limits
  // =========================

  dailyProfitStop      Float?
  dailyLossLimit       Float?
  maxDailyStopLosses   Int @default(3)
  maxOpenTrades        Int @default(1)

  // =========================
  // Execution Controls
  // =========================

  buyEnabled  Boolean @default(true)
  sellEnabled Boolean @default(true)

  maxSpread Float?
  cooldownMinutes Int @default(5)

  sessionFilter Boolean @default(true)
  newsFilter    Boolean @default(true)

  // =========================
  // Analysis Controls
  // =========================

  signalThreshold  Int @default(80)
  minConfirmations Int @default(5)

  // =========================
  // Telegram
  // =========================

  telegramEnabled Boolean @default(false)

  // =========================
  // Advanced Configuration
  // =========================

  analysisConfig Json?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  signals TradingSignal[]
  trades  Trade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([isActive])
}

model MarketCandle {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String

  openTime DateTime

  open   Float
  high   Float
  low    Float
  close  Float
  volume Float?

  source String @default("MARKET_DATA")

  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, openTime])
  @@index([symbol, timeframe])
  @@index([openTime])
}

model TradingSignal {
  id     String @id @default(cuid())
  userId String
  botId  String

  symbol    String
  timeframe String?
  direction String

  entry      Float?
  takeProfit Float?
  stopLoss   Float?
  riskReward Float?

  score      Float?
  confidence Float?

  status String @default("WAITING")
  source String @default("ANALYSIS")

  marketStructure            String?
  supportResistance          String?
  liquidity                  String?
  pullback                   String?
  candlePattern              String?
  volumeConfirmation         String?
  multiTimeframeConfirmation String?
  sessionConfirmation        String?
  volatilityConfirmation     String?
  newsConfirmation           String?

  confirmations Json?
  reasons        Json?
  metadata       Json?

  telegramSent      Boolean  @default(false)
  telegramMessageId String?
  telegramSentAt    DateTime?

  expiresAt DateTime?
  closedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  TradingBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  deliveries TelegramDelivery[]

  @@index([userId])
  @@index([botId])
  @@index([symbol])
  @@index([timeframe])
  @@index([status])
  @@index([direction])
  @@index([createdAt])
}

model TelegramDelivery {
  id       String @id @default(cuid())
  signalId String

  channelId String
  messageId String?

  status String @default("PENDING")

  errorMessage String?

  sentAt    DateTime?
  createdAt DateTime @default(now())

  signal TradingSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([signalId])
  @@index([channelId])
  @@index([status])
}

model AnalysisRun {
  id     String  @id @default(cuid())
  botId  String?
  symbol String

  timeframe String?

  status String @default("RUNNING")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  candlesAnalyzed    Int @default(0)
  confirmationsFound Int @default(0)

  signalGenerated Boolean @default(false)

  errorMessage String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([botId])
  @@index([symbol])
  @@index([timeframe])
  @@index([status])
  @@index([createdAt])
}

model Trade {
  id     String @id @default(cuid())
  userId String
  botId  String

  symbol    String
  direction String

  entryPrice Float?
  exitPrice  Float?

  takeProfit Float?
  stopLoss   Float?

  quantity   Float?
  profitLoss Float?

  status String @default("OPEN")
  source String @default("SIMULATION")

  openedAt DateTime @default(now())
  closedAt DateTime?

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  TradingBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([botId])
  @@index([symbol])
  @@index([status])
  @@index([openedAt])
}
