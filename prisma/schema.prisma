generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./trading.db"
}


model User {
  id String @id @default(cuid())

  name String

  email String @unique

  password String

  role Role @default(USER)

  plan Plan @default(FREE)

  createdAt DateTime @default(now())


  trades Trade[]

  signals Signal[]

  payments Payment[]
}



model Trade {
  id String @id @default(cuid())

  symbol String

  type String

  entryPrice Float

  closePrice Float?

  profitDollar Float @default(0)

  profitToman Float @default(0)

  status String

  createdAt DateTime @default(now())


  userId String

  user User @relation(fields: [userId], references: [id])
}



model Signal {
  id String @id @default(cuid())

  symbol String

  market String

  type String

  entry String

  stop String

  target String

  confidence String

  status String

  createdAt DateTime @default(now())


  userId String?

  user User? @relation(fields: [userId], references: [id])
}



model Bot {
  id String @id @default(cuid())

  name String

  type String

  status String

  description String

  createdAt DateTime @default(now())
}



model Payment {
  id String @id @default(cuid())

  amount Float

  currency String

  status String

  createdAt DateTime @default(now())


  userId String

  user User @relation(fields: [userId], references: [id])
}



model Report {
  id String @id @default(cuid())

  title String

  content String

  createdAt DateTime @default(now())
}



enum Role {
  USER
  VIP
  ADMIN
}


enum Plan {
  FREE
  VIP
  PREMIUM
}
