generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  role String @default("USER")
  plan String @default("FREE")

  // =========================
  // Profile
  // =========================

  avatarUrl   String?
  avatarEmoji String?
  bio         String?

  // =========================
  // Account Control
  // =========================

  isBlocked     Boolean   @default(false)
  blockedAt     DateTime?
  blockedReason String?

  // =========================
  // Current Subscription Summary
  // =========================

  subscriptionStartedAt DateTime?
  subscriptionExpiresAt DateTime?

  // =========================
  // Guest Access
  // Exactly 7 days from activation
  // =========================

  guestUsed      Boolean  @default(false)
  guestStartedAt DateTime?
  guestExpiresAt DateTime?
  guestEndedAt   DateTime?

  // =========================
  // Relations
  // =========================

  sessions          Session[]
  supportTickets    SupportTicket[]
  tradingBots       TradingBot[]
  tradingSignals    TradingSignal[]
  trades            Trade[]
  brokerConnections BrokerConnection[]

  passwordResetTokens PasswordResetToken[]

  newsSetting NewsSetting?
  newsAlerts  NewsAlert[]

  subscriptions UserSubscription[]
  notifications UserNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([plan])
  @@index([isBlocked])
  @@index([subscriptionExpiresAt])
  @@index([guestExpiresAt])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId String

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model BrokerConnection {
  id String @id @default(cuid())

  userId String

  brokerName    String
  platform      String
  server        String
  accountNumber String

  status String @default("DISCONNECTED")

  isDemo   Boolean @default(true)
  isActive Boolean @default(false)

  lastConnectedAt DateTime?
  lastCheckedAt   DateTime?
  errorMessage    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]
}

model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  senderId   String?
  senderType String
  message    String
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model TradingBot {
  id          String  @id @default(cuid())
  userId      String
  name        String
  type        String
  category    String  @default("ANALYSIS")
  description String?

  symbol     String?
  timeframe  String?
  marketType String?

  isActive Boolean @default(false)

  executionMode   String  @default("MANUAL")
  tradingApproval Boolean @default(false)

  botStatus         String    @default("STOPPED")
  stoppedReason     String?
  lastStateChangeAt DateTime?

  autoStopAfterWins   Int?
  autoStopAfterLosses Int?
  autoStopAfterTrades Int?

  stopBeforeNewsMinutes Int @default(0)

  lotMode     String @default("FIXED")
  lotSize     Float  @default(0.01)
  riskPercent Float  @default(1)

  takeProfit Float?
  stopLoss   Float?
  riskReward Float?

  trailingStop         Boolean @default(false)
  trailingStopDistance Float?

  breakEven        Boolean @default(false)
  breakEvenTrigger Float?

  dailyProfitStop    Float?
  dailyLossLimit     Float?
  maxDailyStopLosses Int   @default(3)
  maxOpenTrades      Int   @default(1)

  buyEnabled  Boolean @default(true)
  sellEnabled Boolean @default(true)

  maxSpread       Float?
  cooldownMinutes Int @default(5)

  sessionFilter Boolean @default(true)
  newsFilter    Boolean @default(true)

  signalThreshold  Int @default(80)
  minConfirmations Int @default(5)

  telegramEnabled Boolean @default(false)

  analysisConfig Json?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  signals TradingSignal[]
  trades  Trade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([isActive])
  @@index([botStatus])
  @@index([executionMode])
}

model MarketCandle {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String

  openTime DateTime

  open   Float
  high   Float
  low    Float
  close  Float
  volume Float?

  source String @default("MARKET_DATA")

  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, openTime])
  @@index([symbol, timeframe])
  @@index([openTime])
}

model TradingSignal {
  id     String @id @default(cuid())
  userId String
  botId  String

  symbol    String
  timeframe String?
  direction String

  entry      Float?
  takeProfit Float?
  stopLoss   Float?
  riskReward Float?

  score      Float?
  confidence Float?

  status String @default("WAITING")
  source String @default("ANALYSIS")

  marketStructure            String?
  supportResistance          String?
  liquidity                  String?
  pullback                   String?
  candlePattern              String?
  volumeConfirmation         String?
  multiTimeframeConfirmation String?
  sessionConfirmation        String?
  volatilityConfirmation     String?
  newsConfirmation           String?

  confirmations Json?
  reasons        Json?
  metadata       Json?

  telegramSent      Boolean  @default(false)
  telegramMessageId String?
  telegramSentAt    DateTime?

  expiresAt DateTime?
  closedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  TradingBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  deliveries TelegramDelivery[]

  @@index([userId])
  @@index([botId])
  @@index([symbol])
  @@index([timeframe])
  @@index([status])
  @@index([direction])
  @@index([createdAt])
}

model TelegramDelivery {
  id       String @id @default(cuid())
  signalId String

  channelId String
  messageId String?

  status String @default("PENDING")

  errorMessage String?

  sentAt    DateTime?
  createdAt DateTime @default(now())

  signal TradingSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([signalId])
  @@index([channelId])
  @@index([status])
}

model AnalysisRun {
  id     String  @id @default(cuid())
  botId  String?
  symbol String

  timeframe String?

  status String @default("RUNNING")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  candlesAnalyzed    Int @default(0)
  confirmationsFound Int @default(0)

  signalGenerated Boolean @default(false)

  errorMessage String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([botId])
  @@index([symbol])
  @@index([timeframe])
  @@index([status])
  @@index([createdAt])
}

model Trade {
  id     String @id @default(cuid())
  userId String
  botId  String

  symbol    String
  direction String

  entryPrice Float?
  exitPrice  Float?

  takeProfit Float?
  stopLoss   Float?

  quantity   Float?
  profitLoss Float?

  status String @default("OPEN")
  source String @default("SIMULATION")

  openedAt DateTime @default(now())
  closedAt DateTime?

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  TradingBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([botId])
  @@index([symbol])
  @@index([status])
  @@index([openedAt])
}

model EconomicEvent {
  id String @id @default(cuid())

  externalId String? @unique

  country  String?
  currency String?

  event    String
  category String?

  importance Int @default(1)

  eventTime DateTime

  previous String?
  forecast String?
  actual   String?

  unit String?

  status String @default("SCHEDULED")

  source    String  @default("TRADING_ECONOMICS")
  sourceUrl String?

  rawData Json?

  alerts NewsAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventTime])
  @@index([importance])
  @@index([currency])
  @@index([status])
  @@index([country])
}

model NewsSetting {
  id String @id @default(cuid())

  userId String @unique

  highImpact   Boolean @default(true)
  mediumImpact Boolean @default(true)
  lowImpact    Boolean @default(false)

  currencies Json?

  alertMinutes Json?

  telegramEnabled   Boolean @default(false)
  newsFilterEnabled Boolean @default(true)
  marketRiskEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NewsAlert {
  id String @id @default(cuid())

  userId  String
  eventId String

  alertType String

  scheduledFor DateTime

  status String @default("PENDING")

  sentAt DateTime?

  errorMessage String?

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event EconomicEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  deliveries NewsDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId, alertType])
  @@index([userId])
  @@index([eventId])
  @@index([scheduledFor])
  @@index([status])
}

model NewsDelivery {
  id String @id @default(cuid())

  alertId String

  channel     String
  destination String

  status String @default("PENDING")

  messageId String?

  errorMessage String?

  sentAt    DateTime?
  createdAt DateTime @default(now())

  alert NewsAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@index([channel])
  @@index([status])
}

model UserSubscription {
  id String @id @default(cuid())

  userId String

  plan   String
  status String @default("ACTIVE")

  startsAt  DateTime
  expiresAt DateTime

  price    Float?
  currency String?

  autoRenew Boolean @default(false)

  cancelledAt DateTime?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([startsAt])
  @@index([expiresAt])
  @@index([plan])
}

model UserNotification {
  id String @id @default(cuid())

  userId String

  type    String
  title   String
  message String

  read Boolean @default(false)

  dedupeKey String @unique

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}
