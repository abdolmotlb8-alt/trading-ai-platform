generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  role     String @default("USER")
  plan     String @default("FREE")

  sessions       Session[]
  supportTickets SupportTicket[]
  tradingBots    TradingBot[]
  tradingSignals TradingSignal[]
  trades         Trade[]

  newsSetting NewsSetting?
  newsAlerts  NewsAlert[]
  settings    UserSettings?

  dailyPerformances DailyPerformance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSettings {
  id String @id @default(cuid())

  userId String @unique

  language String @default("fa")
  theme    String @default("dark")

  emailNotifications    Boolean @default(true)
  tradingNotifications  Boolean @default(true)
  newsNotifications     Boolean @default(true)
  securityNotifications Boolean @default(true)

  twoFactorEnabled Boolean @default(false)

  compactMode Boolean @default(false)
  soundEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  senderId   String?
  senderType String
  message    String
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}

model TradingBot {
  id          String  @id @default(cuid())
  userId      String
  name        String
  type        String
  category    String  @default("ANALYSIS")
  description String?

  symbol     String?
  timeframe  String?
  marketType String?

  isActive Boolean @default(false)

  executionMode   String  @default("MANUAL")
  tradingApproval Boolean @default(false)

  botStatus         String    @default("STOPPED")
  stoppedReason     String?
  lastStateChangeAt DateTime?

  autoStopAfterWins   Int?
  autoStopAfterLosses Int?
  autoStopAfterTrades Int?

  stopBeforeNewsMinutes Int @default(0)

  lotMode     String @default("FIXED")
  lotSize     Float  @default(0.01)
  riskPercent Float  @default(1)

  takeProfit Float?
  stopLoss   Float?
  riskReward Float?

  trailingStop         Boolean @default(false)
  trailingStopDistance Float?

  breakEven        Boolean @default(false)
  breakEvenTrigger Float?

  dailyProfitStop    Float?
  dailyLossLimit     Float?
  maxDailyStopLosses Int @default(3)
  maxOpenTrades      Int @default(1)

  buyEnabled  Boolean @default(true)
  sellEnabled Boolean @default(true)

  maxSpread       Float?
  cooldownMinutes Int @default(5)

  sessionFilter Boolean @default(true)
  newsFilter    Boolean @default(true)

  signalThreshold  Int @default(80)
  minConfirmations Int @default(5)

  telegramEnabled Boolean @default(false)

  analysisConfig Json?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  signals TradingSignal[]
  trades  Trade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([isActive])
  @@index([botStatus])
  @@index([executionMode])
  @@index([symbol])
}

model MarketCandle {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String

  openTime DateTime

  open   Float
  high   Float
  low    Float
  close  Float
  volume Float?

  source String @default("MARKET_DATA")

  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, openTime])
  @@index([symbol, timeframe])
  @@index([openTime])
}

model TradingSignal {
  id     String @id @default(cuid())
  userId String
  botId  String

  symbol    String
  timeframe String?
  direction String

  /*
   * Entry
   */
  entry Float?

  /*
   * Legacy single TP/SL fields
   * نگه داشته شده‌اند تا کدهای قبلی سایت خراب نشوند.
   */
  takeProfit Float?
  stopLoss   Float?
  riskReward Float?

  /*
   * Multi Take Profit
   */
  takeProfit1 Float?
  takeProfit2 Float?
  takeProfit3 Float?

  /*
   * Risk / Target in USD
   */
  riskUsd        Float?
  takeProfit1Usd Float?
  takeProfit2Usd Float?
  takeProfit3Usd Float?

  /*
   * Live market state
   */
  currentPrice  Float?
  lastCheckedAt DateTime?

  /*
   * Signal quality
   */
  score      Float?
  confidence Float?

  status String @default("WAITING")
  source String @default("ANALYSIS")

  /*
   * Final signal result
   *
   * WAITING
   * ACTIVE
   * TP1
   * TP2
   * TP3
   * STOP_LOSS
   * EXPIRED
   * CANCELLED
   */
  result String?

  realizedProfitLoss Float?

  /*
   * Result timestamps
   */
  tp1HitAt      DateTime?
  tp2HitAt      DateTime?
  tp3HitAt      DateTime?
  stopLossHitAt DateTime?

  marketStructure            String?
  supportResistance          String?
  liquidity                  String?
  pullback                   String?
  candlePattern              String?
  volumeConfirmation         String?
  multiTimeframeConfirmation String?
  sessionConfirmation        String?
  volatilityConfirmation     String?
  newsConfirmation           String?

  confirmations Json?
  reasons        Json?
  metadata       Json?

  /*
   * Telegram signal delivery
   */
  telegramSent      Boolean  @default(false)
  telegramMessageId String?
  telegramSentAt    DateTime?

  /*
   * Signal lifetime
   */
  expiresAt DateTime?
  closedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  TradingBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  deliveries TelegramDelivery[]
  trades     Trade[]

  @@index([userId])
  @@index([botId])
  @@index([symbol])
  @@index([timeframe])
  @@index([status])
  @@index([direction])
  @@index([result])
  @@index([createdAt])
  @@index([expiresAt])
}

model TelegramDelivery {
  id       String @id @default(cuid())
  signalId String

  channelId String
  messageId String?

  status String @default("PENDING")

  errorMessage String?

  sentAt    DateTime?
  createdAt DateTime @default(now())

  signal TradingSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([signalId])
  @@index([channelId])
  @@index([status])
  @@index([createdAt])
}

model AnalysisRun {
  id     String  @id @default(cuid())
  botId  String?
  symbol String

  timeframe String?

  status String @default("RUNNING")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  candlesAnalyzed    Int @default(0)
  confirmationsFound Int @default(0)

  signalGenerated Boolean @default(false)

  errorMessage String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([botId])
  @@index([symbol])
  @@index([timeframe])
  @@index([status])
  @@index([createdAt])
}

model Trade {
  id     String @id @default(cuid())
  userId String
  botId  String

  /*
   * ارتباط با سیگنال
   *
   * @unique عمداً استفاده نشده.
   * یک سیگنال می‌تواند در آینده چند اجرای واقعی/بخشی داشته باشد.
   */
  signalId String?

  symbol    String
  direction String

  /*
   * Entry / Exit
   */
  entryPrice Float?
  exitPrice  Float?

  /*
   * Legacy TP / SL
   */
  takeProfit Float?
  stopLoss   Float?

  /*
   * Multi TP
   */
  takeProfit1 Float?
  takeProfit2 Float?
  takeProfit3 Float?

  /*
   * Position sizing
   */
  quantity Float?

  /*
   * Financial result
   */
  profitLoss Float?
  fees       Float?
  swap       Float?

  /*
   * Current live price
   */
  currentPrice  Float?
  lastCheckedAt DateTime?

  /*
   * Trade status
   *
   * OPEN
   * TP1
   * TP2
   * TP3
   * CLOSED
   * STOP_LOSS
   * EXPIRED
   * CANCELLED
   */
  status String @default("OPEN")

  /*
   * SIMULATION
   * MANUAL
   * BROKER
   * AUTO
   */
  source String @default("SIMULATION")

  /*
   * Expiry
   */
  expiresAt DateTime?

  /*
   * Open / close
   */
  openedAt DateTime  @default(now())
  closedAt DateTime?

  /*
   * Target hit timestamps
   */
  tp1HitAt      DateTime?
  tp2HitAt      DateTime?
  tp3HitAt      DateTime?
  stopLossHitAt DateTime?

  /*
   * Break-even
   */
  breakEvenActivated Boolean   @default(false)
  breakEvenAt        DateTime?
  breakEvenPrice     Float?

  /*
   * Trailing stop
   */
  trailingStopActivated Boolean   @default(false)
  trailingStopAt        DateTime?
  trailingStopPrice     Float?

  /*
   * Broker integration
   */
  brokerOrderId    String?
  brokerPositionId String?

  brokerEntryPrice Float?
  brokerExitPrice  Float?

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  TradingBot   @relation(fields: [botId], references: [id], onDelete: Cascade)
  signal TradingSignal? @relation(fields: [signalId], references: [id], onDelete: SetNull)

  events TradeEvent[]

  @@index([userId])
  @@index([botId])
  @@index([signalId])
  @@index([symbol])
  @@index([status])
  @@index([source])
  @@index([openedAt])
  @@index([closedAt])
  @@index([expiresAt])
}

model TradeEvent {
  id String @id @default(cuid())

  tradeId String

  /*
   * TP1
   * TP2
   * TP3
   * STOP_LOSS
   * EXPIRED
   * BREAK_EVEN
   * TRAILING_STOP
   * CLOSED
   */
  type String

  symbol    String
  direction String

  price Float?

  /*
   * سود/زیان ایجادشده در این رویداد
   */
  profitLoss Float?

  /*
   * اطلاعات اضافه
   */
  metadata Json?

  /*
   * Telegram result notification
   */
  telegramSent      Boolean  @default(false)
  telegramMessageId String?
  telegramSentAt    DateTime?
  telegramError     String?

  createdAt DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([type])
  @@index([symbol])
  @@index([createdAt])
  @@index([telegramSent])
}

model DailyPerformance {
  id String @id @default(cuid())

  userId String

  /*
   * تاریخ روز.
   *
   * برای هر کاربر یک رکورد در هر روز.
   */
  date DateTime

  /*
   * معاملات
   */
  totalTrades  Int @default(0)
  closedTrades Int @default(0)
  openTrades   Int @default(0)

  /*
   * نتیجه
   */
  winningTrades Int @default(0)
  losingTrades  Int @default(0)
  breakevenTrades Int @default(0)

  /*
   * TP / SL statistics
   */
  tp1Hits Int @default(0)
  tp2Hits Int @default(0)
  tp3Hits Int @default(0)
  stopLossHits Int @default(0)

  /*
   * Financial performance
   */
  grossProfit Float @default(0)
  grossLoss   Float @default(0)

  profitLoss Float @default(0)

  fees Float @default(0)
  swap Float @default(0)

  netProfitLoss Float @default(0)

  /*
   * Win rate
   */
  winRate Float @default(0)

  /*
   * Risk metrics
   */
  totalRiskUsd Float @default(0)
  totalTargetUsd Float @default(0)

  /*
   * Telegram statistics
   */
  telegramSignalsSent Int @default(0)
  telegramResultsSent Int @default(0)
  telegramErrors Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([netProfitLoss])
}

model EconomicEvent {
  id String @id @default(cuid())

  externalId String? @unique

  country  String?
  currency String?

  event    String
  category String?

  importance Int @default(1)

  eventTime DateTime

  previous String?
  forecast String?
  actual   String?

  unit String?

  status String @default("SCHEDULED")

  source    String  @default("TRADING_ECONOMICS")
  sourceUrl String?

  rawData Json?

  alerts NewsAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventTime])
  @@index([importance])
  @@index([currency])
  @@index([status])
  @@index([country])
}

model NewsSetting {
  id String @id @default(cuid())

  userId String @unique

  highImpact   Boolean @default(true)
  mediumImpact Boolean @default(true)
  lowImpact    Boolean @default(false)

  currencies Json?

  alertMinutes Json?

  telegramEnabled   Boolean @default(false)
  newsFilterEnabled Boolean @default(true)
  marketRiskEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NewsAlert {
  id String @id @default(cuid())

  userId  String
  eventId String

  alertType String

  scheduledFor DateTime

  status String @default("PENDING")

  sentAt DateTime?

  errorMessage String?

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event EconomicEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  deliveries NewsDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId, alertType])
  @@index([userId])
  @@index([eventId])
  @@index([scheduledFor])
  @@index([status])
}

model NewsDelivery {
  id String @id @default(cuid())

  alertId String

  channel     String
  destination String

  status String @default("PENDING")

  messageId String?

  errorMessage String?

  sentAt    DateTime?
  createdAt DateTime @default(now())

  alert NewsAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@index([channel])
}
